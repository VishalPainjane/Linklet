# Linklet Environment Configuration

# Core Application
ENVIRONMENT=development
DEBUG=false
PUBLIC_SHORT_BASE_URL=http://localhost:8000
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000"]

# PostgreSQL 17 Persistence
DATABASE_URL=postgresql+asyncpg://linklet:local-only-change-me@localhost:5432/linklet
DIRECT_DATABASE_URL=postgresql+asyncpg://linklet:local-only-change-me@localhost:5432/linklet
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5.0
DB_POOL_RECYCLE=300
DB_ECHO=false

# Redis 7 Distributed Cache & Rate Limiting
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
CACHE_DEFAULT_TTL_SECONDS=900

# RabbitMQ 4 Event Messaging
AMQP_URL=amqp://guest:guest@localhost:5672/
AMQP_EXCHANGE=analytics.events
AMQP_ROUTING_KEY=url.click
AMQP_QUEUE=url.clicks.v1
AMQP_PREFETCH=50
RUN_CLICK_CONSUMER=false

# Rate Limiting Policies
RATE_LIMIT_CREATE_WINDOW_SECONDS=60
RATE_LIMIT_CREATE_MAX_REQUESTS=60
RATE_LIMIT_REDIRECT_WINDOW_SECONDS=60
RATE_LIMIT_REDIRECT_MAX_REQUESTS=600
