# Application Environment
NODE_ENV=development
PORT=3001

# Core Service Configuration
PUBLIC_SHORT_DOMAIN=http://localhost:3001
ALLOWED_WEB_ORIGINS=http://localhost:3000

# PostgreSQL Configuration
DATABASE_URL=postgres://shortener:local-dev-only@localhost:5432/shortener
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONN_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=3000

# Redis Configuration
REDIS_URL=redis://localhost:6379
CACHE_DEFAULT_TTL_SECONDS=900

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=analytics.events
RABBITMQ_QUEUE=url.clicks.v1
RABBITMQ_ROUTING_KEY=url.click
RABBITMQ_PREFETCH=50

# Rate Limiting
RATE_LIMIT_CREATE_WINDOW_SECONDS=60
RATE_LIMIT_CREATE_MAX_REQUESTS=30

